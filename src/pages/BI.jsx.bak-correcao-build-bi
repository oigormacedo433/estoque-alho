function numero(valor) {
  if (valor === null || valor === undefined || valor === "") return 0;
  if (typeof valor === "number") return Number.isFinite(valor) ? valor : 0;

  let texto = String(valor).trim().replace(/\s/g, "");
  if (!texto) return 0;

  if (texto.includes(",") && texto.includes(".")) {
    texto = texto.replace(/\./g, "").replace(",", ".");
  } else if (texto.includes(",")) {
    texto = texto.replace(",", ".");
  } else if (/^\d{1,3}(\.\d{3})+$/.test(texto)) {
    texto = texto.replace(/\./g, "");
  }

  texto = texto.replace(/[^0-9.-]/g, "");
  const convertido = Number(texto);

  return Number.isFinite(convertido) ? convertido : 0;
}

function texto(valor) {
  return String(valor ?? "").trim();
}

function id(valor) {
  const v = texto(valor);
  return v || "";
}

function formatarNumero(valor, casas = 0) {
  return numero(valor).toLocaleString("pt-BR", {
    minimumFractionDigits: casas,
    maximumFractionDigits: casas,
  });
}

function formatarPeso(valor) {
  return formatarNumero(valor, 0) + " kg";
}

function formatarPesoDetalhado(valor) {
  return formatarNumero(valor, 2) + " kg";
}

function formatarMetrica(valor, metrica) {
  return metrica === "peso" ? formatarPeso(valor) : formatarNumero(valor) + " caixas";
}

function subtituloMetrica(caixas, peso) {
  return formatarNumero(caixas) + " caixas · " + formatarPesoDetalhado(peso);
}

function hojeISO() {
  return new Date().toISOString().slice(0, 10);
}

function inicioMesISO() {
  const data = new Date();
  data.setDate(1);
  return data.toISOString().slice(0, 10);
}

function dataRegistro(item) {
  const valor =
    item?.data_carga ||
    item?.data_lancamento ||
    item?.data_saida ||
    item?.data_chegada ||
    item?.data_classificacao ||
    item?.created_at ||
    "";

  if (!valor) return "";

  const data = String(valor).slice(0, 10);

  if (/^\d{4}-\d{2}-\d{2}$/.test(data)) return data;

  return "";
}

function labelData(data) {
  if (!data) return "-";

  const partes = String(data).slice(0, 10).split("-");
  if (partes.length !== 3) return data;

  return partes[2] + "/" + partes[1];
}

function dentroPeriodo(item, filtros) {
  const data = dataRegistro(item);

  if (!data) return true;
  if (filtros.dataInicial && data < filtros.dataInicial) return false;
  if (filtros.dataFinal && data > filtros.dataFinal) return false;

  return true;
}

function statusCarga(item) {
  return texto(item?.status).toLowerCase();
}

function confirmado(item) {
  return statusCarga(item).includes("confirm");
}

function pendente(item) {
  return statusCarga(item).includes("pend");
}

function cancelado(item) {
  return statusCarga(item).includes("cancel");
}

function quantidadeProduto(item) {
  return numero(
    item?.quantidade_caixas ??
      item?.quantidade_total_caixas ??
      item?.quantidade_unidades ??
      item?.quantidade ??
      0
  );
}

function pesoProduto(item) {
  const direto = numero(item?.peso_total_kg);
  if (direto !== 0) return direto;

  const qtd = quantidadeProduto(item);
  const pesoUnidade = numero(
    item?.peso_por_unidade_kg ??
      item?.peso_por_caixa_kg ??
      item?.peso_caixa_kg ??
      10
  );

  return qtd * pesoUnidade;
}

function quantidadeItemCarga(item) {
  return numero(
    item?.quantidade_caixas ??
      item?.quantidade_total_caixas ??
      item?.quantidade_unidades ??
      item?.quantidade ??
      0
  );
}

function quantidadeCarga(carga, itens) {
  const direto = numero(
    carga?.quantidade_total_caixas ??
      carga?.quantidade_caixas ??
      carga?.total_caixas ??
      carga?.quantidade_total_unidades ??
      carga?.quantidade_unidades ??
      0
  );

  if (direto > 0) return direto;

  return itens.reduce((total, item) => total + quantidadeItemCarga(item), 0);
}

function pesoCarga(carga, itens) {
  const direto = numero(carga?.peso_total_kg);
  if (direto !== 0) return direto;

  const qtd = quantidadeCarga(carga, itens);
  const pesoUnidade = numero(
    carga?.peso_por_unidade_kg ??
      carga?.peso_por_caixa_kg ??
      carga?.peso_caixa_kg ??
      10
  );

  return qtd * pesoUnidade;
}

function saldoEstoque(item) {
  return numero(
    item?.saldo_disponivel_caixas ??
      item?.saldo_caixas ??
      item?.saldo_disponivel_unidades ??
      item?.saldo_unidades ??
      0
  );
}

function pesoEstoque(item) {
  const direto = numero(item?.peso_disponivel_kg);
  if (direto !== 0) return direto;

  return saldoEstoque(item) * 10;
}

function areaIdItem(item) {
  return id(
    item?.area_id ||
      item?.area_fazenda_id ||
      item?.area_pivo_id ||
      item?.areas_fazenda?.id ||
      item?.area?.id
  );
}

function calibreIdItem(item) {
  return id(item?.calibre_id || item?.calibres?.id || item?.calibre?.id);
}

function nomeArea(item, areasPorId) {
  const areaId = areaIdItem(item);

  return (
    texto(item?.area_nome) ||
    texto(item?.area_pivo_nome) ||
    texto(item?.areas_fazenda?.nome) ||
    texto(item?.area?.nome) ||
    texto(areasPorId.get(areaId)?.nome) ||
    "Área não informada"
  );
}

function nomeCalibre(item, calibresPorId) {
  const calibreId = calibreIdItem(item);
  const calibre = calibresPorId.get(calibreId);

  const codigo =
    texto(item?.calibre_codigo) ||
    texto(item?.codigo_calibre) ||
    texto(item?.calibres?.codigo) ||
    texto(item?.calibre?.codigo) ||
    texto(calibre?.codigo);

  const nome =
    texto(item?.calibre_nome) ||
    texto(item?.nome_calibre) ||
    texto(item?.calibres?.nome) ||
    texto(item?.calibre?.nome) ||
    texto(calibre?.nome);

  if (codigo && nome && codigo !== nome) return codigo + " — " + nome;
  return codigo || nome || "Sem calibre";
}

function nomeCalibreCurto(item, calibresPorId) {
  const nome = nomeCalibre(item, calibresPorId);
  return nome.split(" — ")[0] || nome;
}

function valor(item, metrica) {
  return metrica === "peso" ? numero(item?.peso) : numero(item?.caixas);
}

function percentual(parte, total) {
  if (numero(total) <= 0) return 0;
  return Math.max(0, Math.min(100, (numero(parte) / numero(total)) * 100));
}

function agrupar(lista, chaveFn, nomeFn, valoresFn) {
  const mapa = new Map();

  lista.forEach((item) => {
    const chave = chaveFn(item) || nomeFn(item) || "sem-chave";
    const nome = nomeFn(item) || "Sem nome";
    const valores = valoresFn(item);

    const atual =
      mapa.get(chave) || {
        id: chave,
        nome,
        caixas: 0,
        peso: 0,
        registros: 0,
      };

    atual.caixas += numero(valores.caixas);
    atual.peso += numero(valores.peso);
    atual.registros += 1;

    mapa.set(chave, atual);
  });

  return Array.from(mapa.values()).sort((a, b) => b.peso - a.peso);
}

async function selecionar(tabela) {
  try {
    const { data, error } = await supabase.from(tabela).select("*");

    if (error) {
      return {
        dados: [],
        erro: tabela + ": " + error.message,
      };
    }

    return {
      dados: Array.isArray(data) ? data : [],
      erro: "",
    };
  } catch (error) {
    return {
      dados: [],
      erro: tabela + ": " + (error?.message || "erro desconhecido"),
    };
  }
}

