function LineChart({ dados, metrica }) {
  const linhas = (dados || []).slice(-31);

  if (!linhas.length) return <EmptyChart />;

  const produto = linhas.map((item) => (metrica === "peso" ? item.produtoPeso : item.produtoCaixas));
  const cargas = linhas.map((item) => (metrica === "peso" ? item.cargaPeso : item.cargaCaixas));
  const maximo = Math.max(1, ...produto, ...cargas);

  const width = 760;
  const height = 300;
  const left = 54;
  const right = 26;
  const top = 34;
  const bottom = 44;
  const chartW = width - left - right;
  const chartH = height - top - bottom;

  function ponto(v, index) {
    const x = left + (linhas.length === 1 ? chartW / 2 : (index / (linhas.length - 1)) * chartW);
    const y = top + chartH - (numero(v) / maximo) * chartH;

    return { x, y };
  }

  function linha(valores) {
    return valores.map((v, index) => {
      const p = ponto(v, index);
      return p.x + "," + p.y;
    }).join(" ");
  }

  function valorCurto(v) {
    if (metrica === "peso") return formatarNumero(v, 0);
    return formatarNumero(v, 0);
  }

  const passoLabel = Math.max(1, Math.ceil(linhas.length / 7));

  return (
    <div>
      <svg viewBox={"0 0 " + width + " " + height} className="h-[320px] w-full">
        {[0, 1, 2, 3, 4].map((n) => {
          const y = top + (n / 4) * chartH;

          return (
            <line key={n} x1={left} x2={width - right} y1={y} y2={y} stroke="#e5e7eb" strokeWidth="1" />
          );
        })}

        <polyline points={linha(produto)} fill="none" stroke="#15803d" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" />
        <polyline points={linha(cargas)} fill="none" stroke="#2563eb" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" />

        {linhas.map((item, index) => {
          const p1 = ponto(produto[index], index);
          const p2 = ponto(cargas[index], index);

          return (
            <g key={item.data}>
              <circle cx={p1.x} cy={p1.y} r="4" fill="#15803d" />
              <circle cx={p2.x} cy={p2.y} r="4" fill="#2563eb" />

              <text x={p1.x} y={Math.max(12, p1.y - 10)} textAnchor="middle" fontSize="10" fontWeight="700" fill="#14532d">
                {valorCurto(produto[index])}
              </text>

              <text x={p2.x} y={Math.min(height - 26, p2.y + 18)} textAnchor="middle" fontSize="10" fontWeight="700" fill="#1d4ed8">
                {valorCurto(cargas[index])}
              </text>

              {index === 0 || index === linhas.length - 1 || index % passoLabel === 0 ? (
                <text x={p1.x} y={height - 12} textAnchor="middle" fontSize="11" fill="#64748b">
                  {item.label}
                </text>
              ) : null}
            </g>
          );
        })}
      </svg>

      <div className="flex items-center justify-center gap-5 text-[13px] text-slate-600">
        <span className="inline-flex items-center gap-1.5">
          <span className="h-2 w-2 rounded-full bg-emerald-700" />
          Produto Final criado
        </span>
        <span className="inline-flex items-center gap-1.5">
          <span className="h-2 w-2 rounded-full bg-blue-600" />
          Cargas expedidas
        </span>
      </div>
    </div>
  );
}

function DonutChart({ dados, metrica }) {
  const lista = (dados || []).filter((item) => valor(item, metrica) > 0).slice(0, 6);
  const total = lista.reduce((soma, item) => soma + valor(item, metrica), 0);
  const cores = ["#ef4444", "#fbbf24", "#8b5cf6", "#16a34a", "#3b82f6", "#06b6d4"];

  if (!lista.length || total <= 0) return <EmptyChart />;

  let acumulado = 0;

  const gradiente = lista
    .map((item, index) => {
      const inicio = acumulado;
      const fatia = percentual(valor(item, metrica), total);
      acumulado += fatia;

      return cores[index % cores.length] + " " + inicio + "% " + acumulado + "%";
    })
    .join(", ");

  return (
