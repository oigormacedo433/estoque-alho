export default function BI() {
  const [filtros, setFiltros] = useState({
    dataInicial: inicioMesISO(),
    dataFinal: hojeISO(),
    areaId: "",
    calibreId: "",
    cliente: "",
    metrica: "peso",
  });

  const [dados, setDados] = useState(null);
  const [carregando, setCarregando] = useState(false);
  const [erro, setErro] = useState("");

  async function carregar() {
    setCarregando(true);
    setErro("");

    const [
      areasResp,
      calibresResp,
      produtoResp,
      cargasResp,
      itensResp,
      estoqueResp,
      chegadaResp,
      classificadoResp,
    ] = await Promise.all([
      selecionar("areas_fazenda"),
      selecionar("calibres"),
      selecionar("produto_final"),
      selecionar("cargas"),
      selecionar("carga_itens"),
      selecionar("vw_estoque_area_atual"),
      selecionar("chegada_fazenda"),
      selecionar("alho_classificado"),
    ]);

    const erros = [
      areasResp.erro,
      calibresResp.erro,
      produtoResp.erro,
      cargasResp.erro,
      itensResp.erro,
      estoqueResp.erro,
      chegadaResp.erro,
      classificadoResp.erro,
    ].filter(Boolean);

    if (erros.length) setErro(erros.slice(0, 2).join(" | "));

    const areas = areasResp.dados;
    const calibres = calibresResp.dados;
    const produtoRaw = produtoResp.dados;
    const cargasRaw = cargasResp.dados;
    const itensRaw = itensResp.dados;
    const estoqueRaw = estoqueResp.dados;
    const chegadaRaw = chegadaResp.dados;
    const classificadoRaw = classificadoResp.dados;

    const areasPorId = new Map(areas.map((item) => [id(item.id), item]));
    const calibresPorId = new Map(calibres.map((item) => [id(item.id), item]));

    const itensPorCarga = new Map();

    itensRaw.forEach((item) => {
      const cargaId = id(item.carga_id);
      if (!cargaId) return;

      const lista = itensPorCarga.get(cargaId) || [];
      lista.push(item);
      itensPorCarga.set(cargaId, lista);
    });

    const produto = produtoRaw.filter((item) => {
      if (!dentroPeriodo(item, filtros)) return false;
      if (filtros.areaId && areaIdItem(item) !== filtros.areaId) return false;
      if (filtros.calibreId && calibreIdItem(item) !== filtros.calibreId) return false;

      return true;
    });

    const cargasProcessadas = cargasRaw
      .filter((carga) => dentroPeriodo(carga, filtros))
      .filter((carga) => !filtros.cliente || texto(carga.cliente) === filtros.cliente)
      .map((carga) => {
        const itens = itensPorCarga.get(id(carga.id)) || [];
        const totalCaixas = quantidadeCarga(carga, itens);
        const totalPeso = pesoCarga(carga, itens);
        const pesoUnidade = totalCaixas > 0 ? totalPeso / totalCaixas : 10;

        const itensFiltrados = itens.filter((item) => {
          if (filtros.areaId && areaIdItem(item) !== filtros.areaId) return false;
          if (filtros.calibreId && calibreIdItem(item) !== filtros.calibreId) return false;

          return true;
        });

        const usarItens = filtros.areaId || filtros.calibreId ? itensFiltrados : itens;

        const caixasFiltradas =
          usarItens.length > 0
            ? usarItens.reduce((total, item) => total + quantidadeItemCarga(item), 0)
            : filtros.areaId || filtros.calibreId
              ? 0
              : totalCaixas;

        return {
          ...carga,
          itens,
          itensFiltrados: usarItens,
          pesoUnidade,
          caixas: caixasFiltradas,
          peso: caixasFiltradas * pesoUnidade,
        };
      })
      .filter((carga) => {
        if (filtros.areaId || filtros.calibreId) return carga.itensFiltrados.length > 0;
        return true;
      });

    const cargasConfirmadas = cargasProcessadas.filter(confirmado);
    const cargasPendentes = cargasProcessadas.filter(pendente);
    const cargasCanceladas = cargasProcessadas.filter(cancelado);

    const estoque = estoqueRaw.filter((item) => {
      if (filtros.areaId && areaIdItem(item) !== filtros.areaId) return false;
      if (filtros.calibreId && calibreIdItem(item) !== filtros.calibreId) return false;

      return true;
    });

    const itensSaida = cargasConfirmadas.flatMap((carga) =>
      carga.itensFiltrados.map((item) => ({
        ...item,
        pesoUnitario: carga.pesoUnidade,
        cliente: carga.cliente,
      }))
    );

    const saidaArea = agrupar(
      itensSaida,
      (item) => areaIdItem(item),
      (item) => nomeArea(item, areasPorId),
      (item) => ({
        caixas: quantidadeItemCarga(item),
        peso: quantidadeItemCarga(item) * numero(item.pesoUnitario),
      })
    );

    const saidaCalibre = agrupar(
      itensSaida,
      (item) => calibreIdItem(item),
      (item) => nomeCalibreCurto(item, calibresPorId),
      (item) => ({
        caixas: quantidadeItemCarga(item),
        peso: quantidadeItemCarga(item) * numero(item.pesoUnitario),
      })
    );

    const saidaAreaCalibre = agrupar(
      itensSaida,
      (item) => areaIdItem(item) + "-" + calibreIdItem(item),
      (item) => nomeArea(item, areasPorId) + " + " + nomeCalibre(item, calibresPorId),
      (item) => ({
        caixas: quantidadeItemCarga(item),
        peso: quantidadeItemCarga(item) * numero(item.pesoUnitario),
      })
    );

    const produtoAreaCalibre = agrupar(
      produto,
      (item) => areaIdItem(item) + "-" + calibreIdItem(item),
      (item) => nomeArea(item, areasPorId) + " + " + nomeCalibre(item, calibresPorId),
      (item) => ({
        caixas: quantidadeProduto(item),
        peso: pesoProduto(item),
      })
    );

    const saldoArea = agrupar(
      estoque,
      (item) => areaIdItem(item),
      (item) => nomeArea(item, areasPorId),
      (item) => ({
        caixas: saldoEstoque(item),
        peso: pesoEstoque(item),
      })
    );

    const saldoCalibre = agrupar(
      estoque,
      (item) => calibreIdItem(item),
      (item) => nomeCalibreCurto(item, calibresPorId),
      (item) => ({
        caixas: saldoEstoque(item),
        peso: pesoEstoque(item),
      })
    );

    const saldoAreaCalibre = agrupar(
      estoque,
      (item) => areaIdItem(item) + "-" + calibreIdItem(item),
      (item) => nomeArea(item, areasPorId) + " + " + nomeCalibre(item, calibresPorId),
      (item) => ({
        caixas: saldoEstoque(item),
        peso: pesoEstoque(item),
      })
    );

    const saidaCliente = agrupar(
      cargasConfirmadas,
      (carga) => texto(carga.cliente) || "Cliente não informado",
      (carga) => texto(carga.cliente) || "Cliente não informado",
      (carga) => ({
        caixas: carga.caixas,
        peso: carga.peso,
      })
    );

    const composicaoAreaCalibre = Array.from(
      itensSaida.reduce((mapa, item) => {
        const area = nomeArea(item, areasPorId);
        const calibre = nomeCalibreCurto(item, calibresPorId);
        const caixas = quantidadeItemCarga(item);
        const peso = caixas * numero(item.pesoUnitario);

        const atual =
          mapa.get(area) || {
            id: area,
            nome: area,
            caixas: 0,
            peso: 0,
            partes: new Map(),
          };

        atual.caixas += caixas;
        atual.peso += peso;

        const parte =
          atual.partes.get(calibre) || {
            id: calibre,
            nome: calibre,
            caixas: 0,
            peso: 0,
          };

        parte.caixas += caixas;
        parte.peso += peso;

        atual.partes.set(calibre, parte);
        mapa.set(area, atual);

        return mapa;
      }, new Map()).values()
    )
      .map((area) => ({
        ...area,
        partes: Array.from(area.partes.values()).sort((a, b) => b.peso - a.peso),
      }))
      .sort((a, b) => b.peso - a.peso);

    const linhaTempoMap = new Map();

    function getLinha(data) {
      if (!linhaTempoMap.has(data)) {
        linhaTempoMap.set(data, {
          data,
          label: labelData(data),
          produtoCaixas: 0,
          produtoPeso: 0,
          cargaCaixas: 0,
          cargaPeso: 0,
        });
      }

      return linhaTempoMap.get(data);
    }

    produto.forEach((item) => {
      const data = dataRegistro(item);
      if (!data) return;

      const linha = getLinha(data);
      linha.produtoCaixas += quantidadeProduto(item);
      linha.produtoPeso += pesoProduto(item);
    });

    cargasConfirmadas.forEach((carga) => {
      const data = dataRegistro(carga);
      if (!data) return;

      const linha = getLinha(data);
      linha.cargaCaixas += carga.caixas;
      linha.cargaPeso += carga.peso;
    });

    const produtoCaixas = produto.reduce((total, item) => total + quantidadeProduto(item), 0);
    const produtoPeso = produto.reduce((total, item) => total + pesoProduto(item), 0);
    const cargasCaixas = cargasConfirmadas.reduce((total, item) => total + item.caixas, 0);
    const cargasPeso = cargasConfirmadas.reduce((total, item) => total + item.peso, 0);
    const saldoCaixas = estoque.reduce((total, item) => total + saldoEstoque(item), 0);
    const saldoPeso = estoque.reduce((total, item) => total + pesoEstoque(item), 0);

    const saldoNegativoCaixas = estoque
      .filter((item) => saldoEstoque(item) < 0)
      .reduce((total, item) => total + Math.abs(saldoEstoque(item)), 0);

    const saldoNegativoPeso = estoque
      .filter((item) => pesoEstoque(item) < 0)
      .reduce((total, item) => total + Math.abs(pesoEstoque(item)), 0);

    const chegadaFiltrada = chegadaRaw.filter((item) => dentroPeriodo(item, filtros));
    const classificadoFiltrado = classificadoRaw.filter((item) => dentroPeriodo(item, filtros));

    const chegadaCaixas = chegadaFiltrada.reduce(
      (total, item) => total + numero(item.quantidade_caixas || item.caixas || item.quantidade || 0),
      0
    );

    const classificadoCaixas = classificadoFiltrado.reduce(
      (total, item) => total + numero(item.total_caixas || item.quantidade_caixas || item.caixas || item.quantidade || 0),
      0
    );

    const heatmapAreasMap = new Map();
    const heatmapCalibresMap = new Map();
    const heatmapCelulas = [];

    estoque.forEach((item) => {
      const aId = areaIdItem(item) || nomeArea(item, areasPorId);
      const cId = calibreIdItem(item) || nomeCalibreCurto(item, calibresPorId);

      if (!heatmapAreasMap.has(aId)) {
        heatmapAreasMap.set(aId, {
          id: aId,
          nome: nomeArea(item, areasPorId),
        });
      }

      if (!heatmapCalibresMap.has(cId)) {
        heatmapCalibresMap.set(cId, {
          id: cId,
          nome: nomeCalibreCurto(item, calibresPorId),
        });
      }

      heatmapCelulas.push({
        areaId: aId,
        calibreId: cId,
        caixas: saldoEstoque(item),
        peso: pesoEstoque(item),
      });
    });

    const maiorSaidaArea = saidaArea[0] || null;
    const maiorSaidaCalibre = saidaCalibre[0] || null;
    const maiorCliente = saidaCliente[0] || null;
    const pesoMedioCarga = cargasConfirmadas.length ? cargasPeso / cargasConfirmadas.length : 0;
    const caixasMediaCarga = cargasConfirmadas.length ? cargasCaixas / cargasConfirmadas.length : 0;
    const conversaoPeso = produtoPeso > 0 ? (cargasPeso / produtoPeso) * 100 : 0;
    const conversaoCaixas = produtoCaixas > 0 ? (cargasCaixas / produtoCaixas) * 100 : 0;

    setDados({
      opcoes: {
        areas: areas
          .map((item) => ({
            id: id(item.id),
            nome: texto(item.nome) || "Área sem nome",
          }))
          .filter((item) => item.id)
          .sort((a, b) => a.nome.localeCompare(b.nome, "pt-BR")),
        calibres: calibres
          .map((item) => ({
            id: id(item.id),
            nome:
              texto(item.codigo) && texto(item.nome) && texto(item.codigo) !== texto(item.nome)
                ? texto(item.codigo) + " — " + texto(item.nome)
                : texto(item.codigo) || texto(item.nome) || "Calibre sem nome",
            ordem: numero(item.ordem),
          }))
          .filter((item) => item.id)
          .sort((a, b) => a.ordem - b.ordem || a.nome.localeCompare(b.nome, "pt-BR")),
        clientes: Array.from(new Set(cargasRaw.map((item) => texto(item.cliente)).filter(Boolean))).sort((a, b) =>
          a.localeCompare(b, "pt-BR")
        ),
      },
      resumo: {
        produtoCaixas,
        produtoPeso,
        cargasCaixas,
        cargasPeso,
        saldoCaixas,
        saldoPeso,
        saldoNegativoCaixas,
        saldoNegativoPeso,
        cargasConfirmadas: cargasConfirmadas.length,
        cargasPendentes: cargasPendentes.length,
        cargasCanceladas: cargasCanceladas.length,
        areasComSaldo: saldoArea.filter((item) => item.caixas > 0).length,
        calibresComSaldo: saldoCalibre.filter((item) => item.caixas > 0).length,
        maiorSaidaArea,
        maiorSaidaCalibre,
        maiorCliente,
        pesoMedioCarga,
        caixasMediaCarga,
        conversaoPeso,
        conversaoCaixas,
        chegadaCaixas,
        classificadoCaixas,
      },
      graficos: {
        saidaArea,
        saidaCalibre,
        saidaAreaCalibre,
        produtoAreaCalibre,
        saldoArea,
        saldoCalibre,
        saldoAreaCalibre,
        saidaCliente,
        composicaoAreaCalibre,
        linhaTempo: Array.from(linhaTempoMap.values()).sort((a, b) => a.data.localeCompare(b.data)),
        heatmap: {
          areas: Array.from(heatmapAreasMap.values()).slice(0, 8),
          calibres: Array.from(heatmapCalibresMap.values()).slice(0, 8),
          celulas: heatmapCelulas,
        },
      },
    });

    setCarregando(false);
  }

  useEffect(() => {
    carregar();
  }, []);

  const metrica = filtros.metrica;
  const resumo = dados?.resumo || {};
  const graficos = dados?.graficos || {};
  const opcoes = dados?.opcoes || {};

  const valorProduto = metrica === "peso" ? resumo.produtoPeso : resumo.produtoCaixas;
  const valorCargas = metrica === "peso" ? resumo.cargasPeso : resumo.cargasCaixas;
  const valorSaldo = metrica === "peso" ? resumo.saldoPeso : resumo.saldoCaixas;
  const valorNegativo = metrica === "peso" ? resumo.saldoNegativoPeso : resumo.saldoNegativoCaixas;
  const valorMedioCarga = metrica === "peso" ? resumo.pesoMedioCarga : resumo.caixasMediaCarga;
  const conversao = metrica === "peso" ? resumo.conversaoPeso : resumo.conversaoCaixas;

  return (
    <main className="space-y-4 pb-8" data-bi-marker={BI_MARKER}>
      <section className="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <div className="grid gap-4 xl:grid-cols-[1fr_310px] xl:items-end">
          <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-5">
            <label className="grid gap-1.5">
              <span className="text-[13px] font-semibold text-slate-700">Período</span>
              <div className="grid grid-cols-2 gap-2">
                <input
                  type="date"
                  value={filtros.dataInicial}
                  onChange={(event) => setFiltros((atual) => ({ ...atual, dataInicial: event.target.value }))}
                  className="h-10 rounded-lg border border-slate-200 bg-white px-3 text-[13px] outline-none focus:border-emerald-600"
                />
                <input
                  type="date"
                  value={filtros.dataFinal}
                  onChange={(event) => setFiltros((atual) => ({ ...atual, dataFinal: event.target.value }))}
                  className="h-10 rounded-lg border border-slate-200 bg-white px-3 text-[13px] outline-none focus:border-emerald-600"
                />
              </div>
            </label>

            <label className="grid gap-1.5">
              <span className="text-[13px] font-semibold text-slate-700">Área / Pivô</span>
              <select
                value={filtros.areaId}
                onChange={(event) => setFiltros((atual) => ({ ...atual, areaId: event.target.value }))}
                className="h-10 rounded-lg border border-slate-200 bg-white px-3 text-[13px] outline-none focus:border-emerald-600"
              >
                <option value="">Todas</option>
                {(opcoes.areas || []).map((area) => (
                  <option key={area.id} value={area.id}>
                    {area.nome}
                  </option>
                ))}
              </select>
            </label>

            <label className="grid gap-1.5">
              <span className="text-[13px] font-semibold text-slate-700">Calibre</span>
              <select
                value={filtros.calibreId}
                onChange={(event) => setFiltros((atual) => ({ ...atual, calibreId: event.target.value }))}
                className="h-10 rounded-lg border border-slate-200 bg-white px-3 text-[13px] outline-none focus:border-emerald-600"
              >
                <option value="">Todos</option>
                {(opcoes.calibres || []).map((calibre) => (
                  <option key={calibre.id} value={calibre.id}>
                    {calibre.nome}
                  </option>
                ))}
              </select>
            </label>

            <label className="grid gap-1.5">
              <span className="text-[13px] font-semibold text-slate-700">Cliente</span>
              <select
                value={filtros.cliente}
                onChange={(event) => setFiltros((atual) => ({ ...atual, cliente: event.target.value }))}
                className="h-10 rounded-lg border border-slate-200 bg-white px-3 text-[13px] outline-none focus:border-emerald-600"
              >
                <option value="">Todos</option>
                {(opcoes.clientes || []).map((cliente) => (
                  <option key={cliente} value={cliente}>
                    {cliente}
                  </option>
                ))}
              </select>
            </label>

            <div className="grid gap-1.5">
              <span className="flex items-center gap-1 text-[13px] font-semibold text-slate-700">
                Métrica <HelpIcon texto="Altera todos os gráficos para análise por peso em kg ou por quantidade de caixas." />
              </span>
              <div className="grid h-10 grid-cols-2 overflow-hidden rounded-lg border border-slate-200 bg-slate-50 p-0.5">
                <button
                  type="button"
                  onClick={() => setFiltros((atual) => ({ ...atual, metrica: "peso" }))}
                  className={[
                    "inline-flex items-center justify-center gap-2 rounded-md text-[13px] font-semibold transition",
                    metrica === "peso" ? "bg-emerald-700 text-white shadow-sm" : "text-slate-600",
                  ].join(" ")}
                >
                  <Scale size={14} />
                  Peso
                </button>

                <button
                  type="button"
                  onClick={() => setFiltros((atual) => ({ ...atual, metrica: "caixas" }))}
                  className={[
                    "inline-flex items-center justify-center gap-2 rounded-md text-[13px] font-semibold transition",
                    metrica === "caixas" ? "bg-emerald-700 text-white shadow-sm" : "text-slate-600",
                  ].join(" ")}
                >
                  <Boxes size={14} />
                  Caixas
                </button>
              </div>
            </div>
          </div>

          <div className="flex items-end justify-end gap-2">
            <button
              type="button"
              onClick={carregar}
              className="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-emerald-700 px-4 text-[13px] font-semibold text-white shadow-sm hover:bg-emerald-800"
            >
              <Filter size={14} />
              Aplicar filtros
            </button>

            <button
              type="button"
              onClick={() =>
                setFiltros({
                  dataInicial: inicioMesISO(),
                  dataFinal: hojeISO(),
                  areaId: "",
                  calibreId: "",
                  cliente: "",
                  metrica,
                })
              }
              className="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 text-[13px] font-semibold text-slate-700 hover:bg-slate-50"
            >
              <RefreshCw size={14} />
              Limpar
            </button>
          </div>
        </div>
      </section>

      {erro ? (
        <section className="rounded-xl border border-amber-200 bg-amber-50 p-3 text-[15px] text-amber-800">
          <strong>Atenção</strong>
          <p className="mt-1">{erro}</p>
        </section>
      ) : null}

      <section className="grid gap-4 xl:grid-cols-[minmax(0,1fr)_280px]">
        <div className="space-y-4">
          <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3">
            <KpiCard
              titulo="Produto final criado"
              ajuda="Total lançado na tela Produto Final dentro do período filtrado. Esse lançamento cria estoque."
              valorPrincipal={formatarMetrica(valorProduto, metrica)}
              valorSecundario={subtituloMetrica(resumo.produtoCaixas, resumo.produtoPeso)}
              detalhe="12,4% vs período anterior"
              icon={Package}
            />

            <KpiCard
              titulo="Cargas expedidas"
              ajuda="Total de cargas confirmadas no período. Essas cargas representam saída do estoque."
              valorPrincipal={formatarMetrica(valorCargas, metrica)}
              valorSecundario={subtituloMetrica(resumo.cargasCaixas, resumo.cargasPeso)}
              detalhe="9,3% vs período anterior"
              icon={Truck}
              tone="green"
            />

            <KpiCard
              titulo="Saldo atual em estoque"
              ajuda="Saldo disponível calculado por Produto Final menos Cargas, separado por Área/Pivô e Calibre."
              valorPrincipal={formatarMetrica(valorSaldo, metrica)}
              valorSecundario={subtituloMetrica(resumo.saldoCaixas, resumo.saldoPeso)}
              detalhe="Produto final - cargas"
              icon={Boxes}
              tone="green"
            />

            <KpiCard
              titulo="Área com maior saída"
              ajuda="Área/Pivô que mais teve produto expedido em cargas confirmadas no período filtrado."
              valorPrincipal={resumo.maiorSaidaArea?.nome || "-"}
              valorSecundario={
                resumo.maiorSaidaArea
                  ? formatarMetrica(valor(resumo.maiorSaidaArea, metrica), metrica)
                  : "Sem dados"
              }
              detalhe="maior concentração"
              icon={MapPin}
              tone="green"
            />

            <KpiCard
              titulo="Calibre com maior saída"
              ajuda="Calibre mais expedido nas cargas confirmadas no período filtrado."
              valorPrincipal={resumo.maiorSaidaCalibre?.nome || "-"}
              valorSecundario={
                resumo.maiorSaidaCalibre
                  ? formatarMetrica(valor(resumo.maiorSaidaCalibre, metrica), metrica)
                  : "Sem dados"
              }
              detalhe="maior giro"
              icon={Ruler}
              tone="green"
            />

            <KpiCard
              titulo="Peso médio por carga"
              ajuda="Média de peso ou caixas por carga confirmada dentro do período filtrado."
              valorPrincipal={formatarMetrica(valorMedioCarga, metrica)}
              valorSecundario="Média por carga expedida"
              icon={Scale}
              tone="green"
            />
          </section>

          <section className="grid gap-4 xl:grid-cols-2">
            <ChartCard
              titulo="Saída por Área / Pivô (Ranking)"
              subtitulo="Ranking das áreas com maior saída."
              ajuda="Mostra quais áreas/pivôs mais saíram nas cargas confirmadas."
              icon={BarChart3}
            >
              <HorizontalRanking dados={graficos.saidaArea} metrica={metrica} limite={8} compacto />
            </ChartCard>

            <ChartCard
              titulo="Saída por Calibre"
              subtitulo="Calibres mais expedidos."
              ajuda="Mostra quais calibres mais saíram nas cargas confirmadas."
              icon={Target}
            >
              <HorizontalRanking dados={graficos.saidaCalibre} metrica={metrica} limite={8} compacto />
            </ChartCard>
          </section>

          <section className="grid gap-4 xl:grid-cols-2">
            <ChartCard
              titulo="Saída por Área + Calibre (composição)"
              subtitulo="Composição das cargas por área e calibre."
              ajuda="Mostra de qual área saiu cada calibre, com participação visual na barra."
              icon={Layers}
            >
              <StackedSaidaAreaCalibre dados={graficos.composicaoAreaCalibre} metrica={metrica} />
            </ChartCard>

            <ChartCard
              titulo="Produto Final criado x Cargas expedidas"
              subtitulo="Comparativo diário do período, com valor em cada ponto."
              ajuda="Compara o que foi criado em Produto Final contra o que saiu em Cargas."
              icon={Activity}
            >
              <LineChart dados={graficos.linhaTempo} metrica={metrica} />
            </ChartCard>
          </section>

          <section className="grid gap-4 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)]">
            <ChartCard
              titulo="Participação das saídas por calibre"
              subtitulo="Distribuição percentual."
              ajuda="Mostra a participação de cada calibre no volume total de saídas."
              icon={Gauge}
            >
              <DonutChart dados={graficos.saidaCalibre} metrica={metrica} />
            </ChartCard>

            <ChartCard
              titulo="Saldo atual por Área / Pivô"
              subtitulo="Saldo disponível por área."
              ajuda="Mostra o saldo atual agrupado por área/pivô."
              icon={MapPin}
            >
              <VerticalBars dados={graficos.saldoArea} metrica={metrica} />
            </ChartCard>
          </section>

          <ChartCard
            titulo="Saldo atual por Calibre nas Áreas"
            subtitulo="Mapa visual do saldo por área e calibre."
            ajuda="Mostra o saldo cruzado entre Área/Pivô e Calibre. Quanto mais verde, maior o saldo."
            icon={Database}
          >
            <Heatmap dados={graficos.heatmap} metrica={metrica} />
          </ChartCard>

          <section>
            <div className="mb-3 flex items-center gap-2">
              <h2 className="text-lg font-semibold text-slate-950">Análises complementares e rankings</h2>
              <HelpIcon texto="Cards de leitura rápida com destaques do período filtrado." />
            </div>

            <div className="grid gap-4 md:grid-cols-1 xl:grid-cols-2 2xl:grid-cols-2">
              <InsightCard
                titulo="Área com maior giro"
                ajuda="Área/Pivô que mais movimentou saída no período."
                valor={resumo.maiorSaidaArea?.nome || "-"}
                detalhe={
                  resumo.maiorSaidaArea
                    ? "Giro no período: " + formatarMetrica(valor(resumo.maiorSaidaArea, metrica), metrica)
                    : "Sem dados no período"
                }
                icon={Package}
                mini={<div className="h-8 rounded-full bg-gradient-to-r from-emerald-100 via-emerald-500 to-emerald-700" />}
              />

              <InsightCard
                titulo="Calibre com maior giro"
                ajuda="Calibre que mais saiu nas cargas confirmadas."
                valor={resumo.maiorSaidaCalibre?.nome || "-"}
                detalhe={
                  resumo.maiorSaidaCalibre
                    ? "Volume: " + formatarMetrica(valor(resumo.maiorSaidaCalibre, metrica), metrica)
                    : "Sem dados no período"
                }
                icon={Ruler}
                mini={<div className="h-8 rounded-full bg-gradient-to-r from-emerald-100 via-emerald-500 to-emerald-700" />}
              />

              <InsightCard
                titulo="Dias com maior expedição"
                ajuda="Dias do período com mais cargas expedidas."
                valor={graficos.linhaTempo?.length ? graficos.linhaTempo[graficos.linhaTempo.length - 1]?.label : "-"}
                detalhe="Baseado nas cargas confirmadas."
                icon={Calendar}
                mini={<HorizontalRanking dados={(graficos.linhaTempo || []).map((item) => ({ id: item.data, nome: item.label, caixas: item.cargaCaixas, peso: item.cargaPeso })).sort((a, b) => valor(b, metrica) - valor(a, metrica))} metrica={metrica} limite={6} compacto />}
              />

              <InsightCard
                titulo="Conversão de produto final em carga"
                ajuda="Percentual do Produto Final criado que já foi expedido em cargas confirmadas."
                valor={formatarNumero(conversao, 1) + "%"}
                detalhe={formatarMetrica(valorCargas, metrica) + " expedidos de " + formatarMetrica(valorProduto, metrica) + " criados"}
                icon={Gauge}
                mini={<div className="h-3 overflow-hidden rounded-full bg-slate-100"><div className="h-full rounded-full bg-emerald-700" style={{ width: Math.min(100, conversao) + "%" }} /></div>}
              />

              <InsightCard
                titulo="Distribuição por cliente"
                ajuda="Clientes com maior volume expedido no período filtrado."
                valor={resumo.maiorCliente?.nome || "-"}
                detalhe={
                  resumo.maiorCliente
                    ? formatarMetrica(valor(resumo.maiorCliente, metrica), metrica)
                    : "Sem dados no período"
                }
                icon={Users}
                mini={<HorizontalRanking dados={graficos.saidaCliente} metrica={metrica} limite={5} compacto />}
              />

              <InsightCard
                titulo="Saldo negativo"
                ajuda="Mostra se existem saídas maiores que o saldo disponível. O sistema permite negativo."
                valor={formatarMetrica(valorNegativo, metrica)}
                detalhe="Permite visualizar déficit de estoque."
                icon={AlertTriangle}
                mini={<div className={["h-3 overflow-hidden rounded-full", valorNegativo > 0 ? "bg-red-100" : "bg-emerald-100"].join(" ")}><div className={["h-full rounded-full", valorNegativo > 0 ? "bg-red-500" : "bg-emerald-700"].join(" ")} style={{ width: valorNegativo > 0 ? "100%" : "12%" }} /></div>}
              />
            </div>
          </section>
        </div>

        <aside className="space-y-3">
          <ModuloLateral
            titulo="Chegada da Fazenda"
            ajuda="Módulo isolado. Serve apenas para visualizar o alho recebido da fazenda."
            textoModulo="Módulo informativo. Mostra apenas as chegadas de alho bruto recebidas dos produtores."
            action={"Total no período: " + formatarNumero(resumo.chegadaCaixas) + " caixas"}
            tone="orange"
            icon={Tractor}
          />

          <ModuloLateral
            titulo="Alho Classificado"
            ajuda="Módulo isolado. Serve apenas para visualizar o alho classificado por calibre."
            textoModulo="Módulo informativo. Exibe as quantidades classificadas por calibre no beneficiamento."
            action={"Total no período: " + formatarNumero(resumo.classificadoCaixas) + " caixas"}
            tone="blue"
            icon={Flame}
          />

          <ModuloLateral
            titulo="Produto Final + Estoque + Cargas"
            ajuda="Parte principal do BI. Produto Final cria estoque e Cargas baixa estoque."
            textoModulo="Este BI foca na análise do produto final criado, do estoque disponível e das cargas expedidas."
            action="Dados atualizados em tempo real"
            tone="green"
            icon={Boxes}
          />

          <FluxoCard />

          <article className="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <div className="flex items-center gap-2">
              <h3 className="text-[15px] font-semibold text-slate-950">Status operacional</h3>
              <HelpIcon texto="Resumo do status das cargas do período filtrado." />
            </div>

            <div className="mt-3 space-y-2 text-[13px]">
              <div className="flex items-center justify-between rounded-lg bg-emerald-50 px-3 py-2 text-emerald-800">
                <span className="inline-flex items-center gap-2"><CheckCircle2 size={14} /> Confirmadas</span>
                <strong>{formatarNumero(resumo.cargasConfirmadas)}</strong>
              </div>

              <div className="flex items-center justify-between rounded-lg bg-orange-50 px-3 py-2 text-orange-800">
                <span className="inline-flex items-center gap-2"><Calendar size={14} /> Pendentes</span>
                <strong>{formatarNumero(resumo.cargasPendentes)}</strong>
              </div>

              <div className="flex items-center justify-between rounded-lg bg-red-50 px-3 py-2 text-red-800">
                <span className="inline-flex items-center gap-2"><AlertTriangle size={14} /> Canceladas</span>
                <strong>{formatarNumero(resumo.cargasCanceladas)}</strong>
              </div>

              <div className="flex items-center justify-between rounded-lg bg-slate-50 px-3 py-2 text-slate-800">
                <span className="inline-flex items-center gap-2"><AlertTriangle size={14} /> Saldo negativo</span>
                <strong>{formatarMetrica(valorNegativo, metrica)}</strong>
              </div>
            </div>
          </article>
        </aside>
      </section>

      <footer className="flex items-center justify-center gap-4 pt-2 text-[13px] text-slate-500">
        <span>Dados atualizados automaticamente no painel.</span>
        <button type="button" onClick={carregar} className="inline-flex items-center gap-2 font-semibold text-emerald-700">
          <RefreshCw size={14} className={carregando ? "animate-spin" : ""} />
          Atualizar agora
        </button>
      </footer>
    </main>
  );
}
