}

function VerticalBars({ dados, metrica }) {
  const linhas = (dados || []).slice(0, 7);
  const maximo = Math.max(1, ...linhas.map((item) => Math.abs(valor(item, metrica))));

  if (!linhas.length) return <EmptyChart />;

  return (
    <div className="flex h-[250px] items-end gap-5 overflow-x-auto rounded-xl bg-white px-4 pb-4 pt-2">
      {linhas.map((item) => {
        const v = valor(item, metrica);
        const altura = Math.max(8, percentual(Math.abs(v), maximo) * 1.82);

        return (
          <div key={item.id || item.nome} className="flex min-w-[70px] flex-col items-center gap-2">
            <span className="text-center text-[13px] font-semibold leading-3 text-slate-700">{formatarMetrica(v, metrica)}</span>
            <div className="w-9 rounded-t-sm bg-emerald-700 shadow-sm" style={{ height: altura }} />
            <span className="max-w-[82px] text-center text-[13px] font-medium leading-3 text-slate-500">{item.nome}</span>
          </div>
        );
      })}
    </div>
  );
}

function Heatmap({ dados, metrica }) {
  const areas = dados?.areas || [];
  const calibres = dados?.calibres || [];
  const celulas = dados?.celulas || [];

  if (!areas.length || !calibres.length) return <EmptyChart />;

  const maximo = Math.max(1, ...celulas.map((item) => Math.abs(valor(item, metrica))));

  function getCelula(areaId, calibreId) {
    return celulas.find((item) => item.areaId === areaId && item.calibreId === calibreId);
  }

  return (
    <div className="overflow-x-auto">
      <div className="min-w-[720px]">
        <div
          className="grid gap-1"
          style={{ gridTemplateColumns: "120px repeat(" + calibres.length + ", minmax(78px, 1fr))" }}
        >
          <div className="rounded bg-slate-50 px-2 py-2 text-[13px] font-semibold text-slate-500">Área / Pivô</div>
          {calibres.map((calibre) => (
            <div key={calibre.id} className="truncate rounded bg-slate-50 px-2 py-2 text-center text-[13px] font-semibold text-slate-600">
              {calibre.nome}
            </div>
          ))}

          {areas.map((area) => (
            <>
              <div key={area.id + "-nome"} className="rounded bg-slate-50 px-2 py-2 text-[13px] font-semibold text-slate-700">
                {area.nome}
              </div>

              {calibres.map((calibre) => {
                const item = getCelula(area.id, calibre.id);
                const v = valor(item || {}, metrica);
                const intensidade = percentual(Math.abs(v), maximo) / 100;

                return (
                  <div
                    key={area.id + "-" + calibre.id}
                    className="rounded px-2 py-2 text-center text-[13px] font-semibold ring-1 ring-white"
                    style={{
                      backgroundColor: v < 0
                        ? "rgba(239, 68, 68, " + Math.max(0.08, intensidade) + ")"
                        : "rgba(34, 197, 94, " + Math.max(0.07, intensidade) + ")",
                      color: v < 0 ? "#991b1b" : "#14532d",
                    }}
                  >
                    {item ? formatarNumero(v, metrica === "peso" ? 0 : 0) : "-"}
                  </div>
                );
              })}
            </>
          ))}
        </div>

        <div className="mt-3 flex items-center justify-center gap-2 text-[13px] text-slate-500">
          <span>Menor saldo</span>
          <div className="h-2 w-44 rounded-full bg-gradient-to-r from-emerald-50 to-emerald-700" />
          <span>Maior saldo</span>
        </div>
      </div>
    </div>
  );
}

