              </div>
              <strong className="text-slate-950">{formatarMetrica(total, metrica)}</strong>
            </div>

            <div className="h-8 overflow-hidden rounded-xl bg-slate-100" style={{ width: Math.max(12, percent(total, maximo)) + "%" }}>
              <div className="flex h-full">
                {area.partes.map((parte, index) => {
                  const valor = valorMetrica(parte, metrica);
                  const largura = percent(valor, total);

                  return (
                    <div
                      key={parte.nome}
                      className={["flex items-center justify-center text-[10px] font-semibold text-white", cores[index % cores.length]].join(" ")}
                      style={{ width: largura + "%" }}
                      title={parte.nome + " · " + formatarMetrica(valor, metrica)}
                    >
                      {largura >= 13 ? formatarNumero(valor, metrica === "peso" ? 0 : 0) : ""}
                    </div>
                  );
                })}
              </div>
            </div>

            <div className="flex flex-wrap gap-2">
              {area.partes.slice(0, 8).map((parte, index) => (
                <span key={parte.nome} className="inline-flex items-center gap-1 rounded-full bg-slate-50 px-2 py-1 text-xs text-slate-600 ring-1 ring-slate-100">
                  <span className={["h-2 w-2 rounded-full", cores[index % cores.length]].join(" ")} />
                  {parte.nome}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  );
}

export default function BI() {
  const [filtros, setFiltros] = useState({
    dataInicial: inicioMesISO(),
    dataFinal: hojeISO(),
    areaId: "",
    calibreId: "",
    cliente: "",
    metrica: "peso",
  });

  const [dados, setDados] = useState(null);
  const [loading, setLoading] = useState(true);
  const [erro, setErro] = useState("");

  async function carregar() {
    setLoading(true);
    setErro("");

    const respostas = await Promise.all([
      selectAll("areas_fazenda"),
      selectAll("calibres"),
      selectAll("produto_final"),
      selectAll("cargas"),
      selectAll("carga_itens"),
      selectAll("vw_estoque_area_atual"),
      selectAll("chegada_fazenda"),
      selectAll("alho_classificado"),
    ]);

    const erros = respostas.map((r) => r.error).filter(Boolean);
    if (erros.length) setErro(erros.slice(0, 2).join(" | "));

    const [areasRaw, calibresRaw, produtoRaw, cargasRaw, itensRaw, estoqueRaw, chegadaRaw, classificadoRaw] = respostas.map((r) => r.data);

    const areas = new Map(areasRaw.map((item) => [id(item.id), item]));
    const calibres = new Map(calibresRaw.map((item) => [id(item.id), item]));

    const itensPorCarga = new Map();
    itensRaw.forEach((item) => {
      const cargaId = id(item.carga_id);
      if (!cargaId) return;
      const lista = itensPorCarga.get(cargaId) || [];
      lista.push(item);
      itensPorCarga.set(cargaId, lista);
    });

    const produto = produtoRaw.filter((item) => {
      if (!dentroPeriodo(item, filtros)) return false;
      if (filtros.areaId && areaId(item) !== filtros.areaId) return false;
      if (filtros.calibreId && calibreId(item) !== filtros.calibreId) return false;
      return true;
    });

    const cargasConfirmadas = cargasRaw
      .filter((carga) => dentroPeriodo(carga, filtros))
      .filter((carga) => statusConfirmado(carga))
      .filter((carga) => !filtros.cliente || texto(carga.cliente) === filtros.cliente)
      .map((carga) => {
        const itens = itensPorCarga.get(id(carga.id)) || [];
        const totalQtd = qtdCargaTotal(carga, itens);
        const totalPeso = pesoCargaTotal(carga, itens);
        const pesoUnidade = totalQtd > 0 ? totalPeso / totalQtd : 10;

        const itensFiltrados = itens.filter((item) => {
          if (filtros.areaId && areaId(item) !== filtros.areaId) return false;
          if (filtros.calibreId && calibreId(item) !== filtros.calibreId) return false;
          return true;
        });

        const usarItens = filtros.areaId || filtros.calibreId ? itensFiltrados : itens;

        const caixas = usarItens.length ? usarItens.reduce((s, item) => s + qtdItemCarga(item), 0) : 0;
        const peso = caixas * pesoUnidade;

        return {
          ...carga,
          itensFiltrados: usarItens,
          caixas,
          peso,
          pesoUnidade,
        };
      })
      .filter((carga) => {
        if (filtros.areaId || filtros.calibreId) return carga.itensFiltrados.length > 0;
        return true;
      });

    const estoque = estoqueRaw.filter((item) => {
      if (filtros.areaId && areaId(item) !== filtros.areaId) return false;
      if (filtros.calibreId && calibreId(item) !== filtros.calibreId) return false;
      return true;
    });

    const itensSaida = cargasConfirmadas.flatMap((carga) =>
      carga.itensFiltrados.map((item) => ({
        ...item,
        pesoUnitario: carga.pesoUnidade,
        cliente: carga.cliente,
      }))
    );

    const saidaAreaCalibre = agrupar(
      itensSaida,
      (item) => areaId(item) + "-" + calibreId(item),
      (item) => nomeArea(item, areas) + " + " + nomeCalibre(item, calibres),
      (item) => ({
        caixas: qtdItemCarga(item),
        peso: qtdItemCarga(item) * numero(item.pesoUnitario || 10),
      })
    );

    const produtoAreaCalibre = agrupar(
      produto,
      (item) => areaId(item) + "-" + calibreId(item),
      (item) => nomeArea(item, areas) + " + " + nomeCalibre(item, calibres),
      (item) => ({
        caixas: qtdProduto(item),
        peso: pesoProduto(item),
      })
    );

    const saldoAreaCalibre = agrupar(
      estoque,
      (item) => areaId(item) + "-" + calibreId(item),
      (item) => nomeArea(item, areas) + " + " + nomeCalibre(item, calibres),
      (item) => ({
        caixas: saldoEstoque(item),
        peso: pesoEstoque(item),
      })
    );

    const saldoArea = agrupar(
      estoque,
      (item) => areaId(item),
      (item) => nomeArea(item, areas),
      (item) => ({
        caixas: saldoEstoque(item),
        peso: pesoEstoque(item),
      })
    );

    const saidaCalibre = agrupar(
      itensSaida,
      (item) => calibreId(item),
      (item) => nomeCalibre(item, calibres),
      (item) => ({
        caixas: qtdItemCarga(item),
        peso: qtdItemCarga(item) * numero(item.pesoUnitario || 10),
      })
    );

    const saidaCliente = agrupar(
      cargasConfirmadas,
      (carga) => texto(carga.cliente) || "Cliente não informado",
      (carga) => texto(carga.cliente) || "Cliente não informado",
      (carga) => ({
        caixas: carga.caixas,
        peso: carga.peso,
      })
    );

    const composicao = Array.from(
      itensSaida.reduce((mapa, item) => {
        const area = nomeArea(item, areas);
        const calibre = nomeCalibre(item, calibres);
        const qtd = qtdItemCarga(item);
        const peso = qtd * numero(item.pesoUnitario || 10);

        const atual = mapa.get(area) || {
          id: area,
          nome: area,
          caixas: 0,
          peso: 0,
          partes: new Map(),
        };

        atual.caixas += qtd;
        atual.peso += peso;

        const parte = atual.partes.get(calibre) || {
          id: calibre,
          nome: calibre,
          caixas: 0,
          peso: 0,
        };

        parte.caixas += qtd;
        parte.peso += peso;

        atual.partes.set(calibre, parte);
        mapa.set(area, atual);

        return mapa;
      }, new Map()).values()
    )
      .map((area) => ({
        ...area,
        partes: Array.from(area.partes.values()).sort((a, b) => b.peso - a.peso),
      }))
      .sort((a, b) => b.peso - a.peso);

    const porDia = new Map();

    function diaBase(data) {
      if (!porDia.has(data)) {
        const [ano, mes, dia] = data.split("-");
        porDia.set(data, {
          data,
          label: dia + "/" + mes,
          produtoCaixas: 0,
          produtoPeso: 0,
          cargaCaixas: 0,
          cargaPeso: 0,
        });
      }
      return porDia.get(data);
    }

    produto.forEach((item) => {
      const data = dataRegistro(item);
      if (!data) return;
      const dia = diaBase(data);
      dia.produtoCaixas += qtdProduto(item);
      dia.produtoPeso += pesoProduto(item);
    });

    cargasConfirmadas.forEach((carga) => {
      const data = dataRegistro(carga);
      if (!data) return;
      const dia = diaBase(data);
      dia.cargaCaixas += carga.caixas;
      dia.cargaPeso += carga.peso;
    });

    const produtoCaixas = produto.reduce((s, item) => s + qtdProduto(item), 0);
    const produtoPeso = produto.reduce((s, item) => s + pesoProduto(item), 0);
    const cargaCaixas = cargasConfirmadas.reduce((s, item) => s + item.caixas, 0);
    const cargaPeso = cargasConfirmadas.reduce((s, item) => s + item.peso, 0);
    const saldoCaixas = estoque.reduce((s, item) => s + saldoEstoque(item), 0);
    const saldoPeso = estoque.reduce((s, item) => s + pesoEstoque(item), 0);

    const chegadaCaixas = chegadaRaw.filter((item) => dentroPeriodo(item, filtros)).reduce((s, item) => s + numero(item.quantidade_caixas || item.caixas || item.quantidade || 0), 0);
    const classificadoCaixas = classificadoRaw.filter((item) => dentroPeriodo(item, filtros)).reduce((s, item) => s + numero(item.total_caixas || item.quantidade_caixas || item.caixas || item.quantidade || 0), 0);

    setDados({
      areas: areasRaw.map((item) => ({ id: id(item.id), nome: texto(item.nome) })).filter((item) => item.id),
      calibres: calibresRaw.map((item) => ({
        id: id(item.id),
        nome: texto(item.codigo) && texto(item.nome) && texto(item.codigo) !== texto(item.nome) ? texto(item.codigo) + " — " + texto(item.nome) : texto(item.codigo) || texto(item.nome),
      })).filter((item) => item.id),
      clientes: Array.from(new Set(cargasRaw.map((item) => texto(item.cliente)).filter(Boolean))).sort(),
      resumo: {
        produtoCaixas,
        produtoPeso,
        cargaCaixas,
        cargaPeso,
        saldoCaixas,
        saldoPeso,
        saldoNegativoCaixas: estoque.filter((item) => saldoEstoque(item) < 0).reduce((s, item) => s + Math.abs(saldoEstoque(item)), 0),
        saldoNegativoPeso: estoque.filter((item) => pesoEstoque(item) < 0).reduce((s, item) => s + Math.abs(pesoEstoque(item)), 0),
        areasComSaldo: saldoArea.filter((item) => item.caixas > 0).length,
        calibresComSaida: saidaCalibre.length,
        chegadaCaixas,
        classificadoCaixas,
      },
      graficos: {
        saidaAreaCalibre,
        produtoAreaCalibre,
        saldoAreaCalibre,
        saldoArea,
        saidaCalibre,
        saidaCliente,
        composicao,
        linhaTempo: Array.from(porDia.values()).sort((a, b) => a.data.localeCompare(b.data)),
      },
    });

    setLoading(false);
  }

  useEffect(() => {
    carregar();
  }, []);

  const metrica = filtros.metrica;
  const resumo = dados?.resumo || {};
  const graficos = dados?.graficos || {};

  const valorProduto = metrica === "peso" ? resumo.produtoPeso : resumo.produtoCaixas;
  const valorCarga = metrica === "peso" ? resumo.cargaPeso : resumo.cargaCaixas;
  const valorSaldo = metrica === "peso" ? resumo.saldoPeso : resumo.saldoCaixas;
  const valorNegativo = metrica === "peso" ? resumo.saldoNegativoPeso : resumo.saldoNegativoCaixas;

  return (
    <main className="space-y-6 pb-10" data-bi-marker={MARCADOR_BI_NOVO}>
      <header>
        <h1 className="text-3xl font-semibold tracking-tight text-slate-950">BI Operacional</h1>
        <p className="mt-1 text-sm text-slate-500">
          Produto Final cria estoque. Cargas baixam estoque. Análise focada em Área/Pivô, Calibre, Caixas e Peso.
        </p>
      </header>

      <section className="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
        <div className="mb-5">
          <h2 className="text-lg font-semibold text-slate-950">Filtros do BI</h2>
          <p className="mt-1 text-sm text-slate-500">Use peso ou caixas para mudar a base de todos os gráficos.</p>
        </div>

        <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-7">
          <label className="grid gap-2">
            <span className="text-sm font-medium text-slate-700">Data inicial</span>
            <input type="date" value={filtros.dataInicial} onChange={(e) => setFiltros((a) => ({ ...a, dataInicial: e.target.value }))} className="h-12 rounded-xl border border-slate-200 px-4 text-sm outline-none focus:border-emerald-500" />
          </label>

          <label className="grid gap-2">
            <span className="text-sm font-medium text-slate-700">Data final</span>
            <input type="date" value={filtros.dataFinal} onChange={(e) => setFiltros((a) => ({ ...a, dataFinal: e.target.value }))} className="h-12 rounded-xl border border-slate-200 px-4 text-sm outline-none focus:border-emerald-500" />
          </label>

          <label className="grid gap-2">
            <span className="text-sm font-medium text-slate-700">Área / Pivô</span>
            <select value={filtros.areaId} onChange={(e) => setFiltros((a) => ({ ...a, areaId: e.target.value }))} className="h-12 rounded-xl border border-slate-200 px-4 text-sm outline-none focus:border-emerald-500">
              <option value="">Todas as áreas</option>
              {(dados?.areas || []).map((area) => <option key={area.id} value={area.id}>{area.nome}</option>)}
            </select>
          </label>

          <label className="grid gap-2">
            <span className="text-sm font-medium text-slate-700">Calibre</span>
            <select value={filtros.calibreId} onChange={(e) => setFiltros((a) => ({ ...a, calibreId: e.target.value }))} className="h-12 rounded-xl border border-slate-200 px-4 text-sm outline-none focus:border-emerald-500">
              <option value="">Todos os calibres</option>
              {(dados?.calibres || []).map((calibre) => <option key={calibre.id} value={calibre.id}>{calibre.nome}</option>)}
            </select>
          </label>

          <label className="grid gap-2">
            <span className="text-sm font-medium text-slate-700">Cliente</span>
            <select value={filtros.cliente} onChange={(e) => setFiltros((a) => ({ ...a, cliente: e.target.value }))} className="h-12 rounded-xl border border-slate-200 px-4 text-sm outline-none focus:border-emerald-500">
              <option value="">Todos os clientes</option>
              {(dados?.clientes || []).map((cliente) => <option key={cliente} value={cliente}>{cliente}</option>)}
            </select>
          </label>

          <div className="grid gap-2">
            <span className="text-sm font-medium text-slate-700">Métrica</span>
            <div className="flex h-12 rounded-xl bg-slate-50 p-1 ring-1 ring-slate-200">
              <button type="button" onClick={() => setFiltros((a) => ({ ...a, metrica: "peso" }))} className={["flex-1 rounded-lg text-sm font-semibold", filtros.metrica === "peso" ? "bg-emerald-700 text-white" : "text-slate-600"].join(" ")}>
                Kg
              </button>
              <button type="button" onClick={() => setFiltros((a) => ({ ...a, metrica: "caixas" }))} className={["flex-1 rounded-lg text-sm font-semibold", filtros.metrica === "caixas" ? "bg-emerald-700 text-white" : "text-slate-600"].join(" ")}>
                Caixas
              </button>
            </div>
          </div>

          <div className="flex items-end gap-2">
            <button type="button" onClick={() => setFiltros({ dataInicial: inicioMesISO(), dataFinal: hojeISO(), areaId: "", calibreId: "", cliente: "", metrica: filtros.metrica })} className="inline-flex h-12 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-sm font-medium text-slate-700">
              <X size={16} />
              Limpar
            </button>

            <button type="button" onClick={carregar} className="inline-flex h-12 items-center gap-2 rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white">
              <RefreshCw size={16} className={loading ? "animate-spin" : ""} />
              Atualizar
            </button>
          </div>
        </div>
      </section>

      {erro ? (
        <section className="rounded-3xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
          <strong>Atenção</strong>
          <p className="mt-1">{erro}</p>
        </section>
      ) : null}

      <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-6">
        <Card titulo="Produto Final" valor={formatarMetrica(valorProduto, metrica)} subtitulo={formatarNumero(resumo.produtoCaixas) + " caixas · " + formatarPeso(resumo.produtoPeso)} icon={Package} />
        <Card titulo="Cargas / Saídas" valor={formatarMetrica(valorCarga, metrica)} subtitulo={formatarNumero(resumo.cargaCaixas) + " caixas · " + formatarPeso(resumo.cargaPeso)} icon={Truck} cor="blue" />
        <Card titulo="Saldo disponível" valor={formatarMetrica(valorSaldo, metrica)} subtitulo="Produto Final menos Cargas" icon={Boxes} />
        <Card titulo="Saldo negativo" valor={formatarMetrica(valorNegativo, metrica)} subtitulo="Permite estoque negativo" icon={AlertTriangle} cor={valorNegativo > 0 ? "red" : "emerald"} />
        <Card titulo="Áreas com saldo" valor={formatarNumero(resumo.areasComSaldo)} subtitulo="áreas disponíveis" icon={MapPin} cor="amber" />
        <Card titulo="Calibres com saída" valor={formatarNumero(resumo.calibresComSaida)} subtitulo="calibres carregados" icon={Target} cor="violet" />
      </section>

      <section className="grid gap-6 xl:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
        <Painel titulo="Produto Final x Cargas por dia" subtitulo="Comparativo visual por período." icon={Activity}>
          <BarrasLinhaTempo dados={graficos.linhaTempo} metrica={metrica} />
          <div className="mt-4 flex items-center justify-center gap-6 text-xs text-slate-600">
            <span className="inline-flex items-center gap-2"><span className="h-3 w-3 rounded-full bg-emerald-700" /> Produto Final</span>
            <span className="inline-flex items-center gap-2"><span className="h-3 w-3 rounded-full bg-blue-600" /> Cargas</span>
          </div>
        </Painel>

        <Painel titulo="Saldo disponível por Área / Pivô" subtitulo="Onde ainda tem estoque disponível." icon={MapPin}>
          <Barras dados={graficos.saldoArea} metrica={metrica} />
        </Painel>
      </section>

      <section className="grid gap-6 xl:grid-cols-2">
        <Painel titulo="Saídas por Área / Pivô + Calibre" subtitulo="O principal: mostra exatamente de qual área e qual calibre saiu." icon={Truck}>
          <Barras dados={graficos.saidaAreaCalibre} metrica={metrica} cor="bg-blue-600" />
        </Painel>

        <Painel titulo="Produto Final por Área / Pivô + Calibre" subtitulo="Mostra onde o estoque foi criado no Produto Final." icon={Package}>
          <Barras dados={graficos.produtoAreaCalibre} metrica={metrica} cor="bg-emerald-700" />
        </Painel>
      </section>

      <Painel titulo="Distribuição das saídas por Área / Pivô e Calibre" subtitulo="Cada barra mostra a área, e dentro dela a composição por calibre." icon={Layers}>
        <Composicao dados={graficos.composicao} metrica={metrica} />
      </Painel>

      <section className="grid gap-6 xl:grid-cols-3">
        <Painel titulo="Saldo por Área + Calibre" subtitulo="Saldo atual detalhado por combinação." icon={Boxes}>
          <Barras dados={graficos.saldoAreaCalibre} metrica={metrica} />
        </Painel>

        <Painel titulo="Saídas por Calibre" subtitulo="Calibres mais carregados." icon={Target}>
          <Barras dados={graficos.saidaCalibre} metrica={metrica} cor="bg-violet-600" />
        </Painel>

        <Painel titulo="Saídas por Cliente" subtitulo="Clientes com maior volume carregado." icon={BarChart3}>
          <Barras dados={graficos.saidaCliente} metrica={metrica} cor="bg-teal-500" />
        </Painel>
      </section>

      <section className="grid gap-6 xl:grid-cols-2">
        <Painel titulo="Chegada da Fazenda" subtitulo="Informativo isolado. Não alimenta automaticamente Produto Final." icon={Truck}>
          <div className="rounded-2xl bg-amber-50 p-5 text-amber-800">
            <p className="text-sm">Total recebido no período</p>
            <strong className="mt-2 block text-3xl font-semibold">{formatarNumero(resumo.chegadaCaixas)} caixas</strong>
          </div>
        </Painel>

        <Painel titulo="Alho Classificado" subtitulo="Informativo isolado. Não baixa nem alimenta Produto Final automaticamente." icon={Layers}>
          <div className="rounded-2xl bg-blue-50 p-5 text-blue-800">
            <p className="text-sm">Total classificado no período</p>
            <strong className="mt-2 block text-3xl font-semibold">{formatarNumero(resumo.classificadoCaixas)} caixas</strong>
          </div>
        </Painel>
      </section>
    </main>
  );
}
