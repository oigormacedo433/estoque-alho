function Barras({ dados, metrica, cor = "bg-emerald-700" }) {
  const linhas = (dados || []).slice(0, 8);
  const maximo = Math.max(...linhas.map((item) => Math.abs(valorMetrica(item, metrica))), 0);

  if (!linhas.length || maximo <= 0) {
    return (
      <div className="flex min-h-[220px] items-center justify-center rounded-2xl border border-dashed border-slate-200 bg-slate-50 text-sm text-slate-500">
        Sem dados para exibir.
      </div>
    );
  }

  return (
    <div className="space-y-4">
      {linhas.map((item) => {
        const valor = valorMetrica(item, metrica);
        const largura = Math.max(4, (Math.abs(valor) / maximo) * 100);
        const negativo = valor < 0;

        return (
          <div key={item.id || item.nome} className="grid gap-2">
            <div className="flex items-center justify-between gap-4 text-sm">
              <span className="max-w-[72%] truncate font-semibold text-slate-950">{item.nome}</span>
              <span className={negativo ? "font-semibold text-red-600" : "font-semibold text-slate-950"}>
                {formatarMetrica(valor, metrica)}
              </span>
            </div>
            <div className="h-4 overflow-hidden rounded-full bg-slate-100">
              <div className={["h-full rounded-full", negativo ? "bg-red-500" : cor].join(" ")} style={{ width: largura + "%" }} />
            </div>
            <p className="text-xs text-slate-400">
              {formatarNumero(item.caixas)} caixas · {formatarPeso(item.peso)}
            </p>
          </div>
        );
      })}
    </div>
  );
}

