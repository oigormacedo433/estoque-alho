function Composicao({ dados, metrica }) {
  const areas = (dados || []).slice(0, 7);
  const maximo = Math.max(...areas.map((area) => valorMetrica(area, metrica)), 0);
  const cores = ["bg-emerald-700", "bg-teal-500", "bg-blue-600", "bg-amber-500", "bg-violet-600", "bg-red-500", "bg-cyan-600", "bg-lime-600"];

  if (!areas.length || maximo <= 0) {
