function numero(valor) {
  if (valor === null || valor === undefined || valor === "") return 0;
  if (typeof valor === "number") return Number.isFinite(valor) ? valor : 0;

  let texto = String(valor).trim().replace(/\s/g, "");
  if (!texto) return 0;

  if (texto.includes(",") && texto.includes(".")) {
    texto = texto.replace(/\./g, "").replace(",", ".");
  } else if (texto.includes(",")) {
    texto = texto.replace(",", ".");
  } else if (/^\d{1,3}(\.\d{3})+$/.test(texto)) {
    texto = texto.replace(/\./g, "");
  }

  texto = texto.replace(/[^0-9.-]/g, "");
  const n = Number(texto);
  return Number.isFinite(n) ? n : 0;
}

function texto(valor) {
  return String(valor ?? "").trim();
}

function formatarNumero(valor, casas = 0) {
  return numero(valor).toLocaleString("pt-BR", {
    minimumFractionDigits: casas,
    maximumFractionDigits: casas,
  });
}

function formatarPeso(valor) {
  return formatarNumero(valor, 2) + " kg";
}

function hojeISO() {
  return new Date().toISOString().slice(0, 10);
}

function inicioMesISO() {
  const data = new Date();
  data.setDate(1);
  return data.toISOString().slice(0, 10);
}

function dataRegistro(item) {
  const valor =
    item?.data_carga ||
    item?.data_lancamento ||
    item?.data_chegada ||
    item?.data_classificacao ||
    item?.created_at ||
    "";

  if (!valor) return "";
  return String(valor).slice(0, 10);
}

function id(valor) {
  const v = texto(valor);
  return v || "";
}

function dentroPeriodo(item, filtros) {
  const data = dataRegistro(item);
  if (!data) return true;
  if (filtros.dataInicial && data < filtros.dataInicial) return false;
  if (filtros.dataFinal && data > filtros.dataFinal) return false;
  return true;
}

function statusConfirmado(carga) {
  return texto(carga?.status).toLowerCase().includes("confirm");
}

function qtdItemCarga(item) {
  return numero(item?.quantidade_caixas ?? item?.quantidade_unidades ?? item?.quantidade ?? 0);
}

function qtdProduto(item) {
  return numero(item?.quantidade_caixas ?? item?.quantidade_total_caixas ?? item?.quantidade_unidades ?? item?.quantidade ?? 0);
}

function pesoProduto(item) {
  const direto = numero(item?.peso_total_kg);
  if (direto !== 0) return direto;

  const qtd = qtdProduto(item);
  const pesoUnidade = numero(item?.peso_por_unidade_kg ?? item?.peso_por_caixa_kg ?? item?.peso_caixa_kg ?? 10);

  return qtd * pesoUnidade;
}

function qtdCargaTotal(carga, itens) {
  const direto = numero(carga?.quantidade_total_caixas ?? carga?.quantidade_total_unidades ?? carga?.quantidade_caixas ?? 0);
  if (direto > 0) return direto;
  return itens.reduce((s, item) => s + qtdItemCarga(item), 0);
}

function pesoCargaTotal(carga, itens) {
  const direto = numero(carga?.peso_total_kg);
  if (direto !== 0) return direto;

  const qtd = qtdCargaTotal(carga, itens);
  const pesoUnidade = numero(carga?.peso_por_unidade_kg ?? carga?.peso_por_caixa_kg ?? carga?.peso_caixa_kg ?? 10);

  return qtd * pesoUnidade;
}

function saldoEstoque(item) {
  return numero(item?.saldo_disponivel_caixas ?? item?.saldo_caixas ?? item?.saldo_disponivel_unidades ?? item?.saldo_unidades ?? 0);
}

function pesoEstoque(item) {
  const direto = numero(item?.peso_disponivel_kg);
  if (direto !== 0) return direto;
  return saldoEstoque(item) * 10;
}

function nomeArea(item, areas) {
  const areaId = id(item?.area_id || item?.area_fazenda_id || item?.area_pivo_id || item?.areas_fazenda?.id);
  return (
    texto(item?.area_nome) ||
    texto(item?.area_pivo_nome) ||
    texto(item?.areas_fazenda?.nome) ||
    texto(item?.area?.nome) ||
    texto(areas.get(areaId)?.nome) ||
    "Área não informada"
  );
}

function areaId(item) {
  return id(item?.area_id || item?.area_fazenda_id || item?.area_pivo_id || item?.areas_fazenda?.id);
}

function nomeCalibre(item, calibres) {
  const calibreId = id(item?.calibre_id || item?.calibres?.id);
  const calibre = calibres.get(calibreId);

  const codigo =
    texto(item?.calibre_codigo) ||
    texto(item?.codigo_calibre) ||
    texto(item?.calibres?.codigo) ||
    texto(item?.calibre?.codigo) ||
    texto(calibre?.codigo);

  const nome =
    texto(item?.calibre_nome) ||
    texto(item?.nome_calibre) ||
    texto(item?.calibres?.nome) ||
    texto(item?.calibre?.nome) ||
    texto(calibre?.nome);

  if (codigo && nome && codigo !== nome) return codigo + " — " + nome;
  return codigo || nome || "Sem calibre";
}

function calibreId(item) {
  return id(item?.calibre_id || item?.calibres?.id);
}

function agrupar(lista, chaveFn, nomeFn, valoresFn) {
  const mapa = new Map();

  lista.forEach((item) => {
    const chave = chaveFn(item) || nomeFn(item);
    const nome = nomeFn(item);
    const valores = valoresFn(item);

    const atual = mapa.get(chave) || {
      id: chave,
      nome,
      caixas: 0,
      peso: 0,
      registros: 0,
    };

    atual.caixas += numero(valores.caixas);
    atual.peso += numero(valores.peso);
    atual.registros += 1;

    mapa.set(chave, atual);
  });

  return Array.from(mapa.values()).sort((a, b) => b.peso - a.peso);
}

function valorMetrica(item, metrica) {
  return metrica === "peso" ? numero(item?.peso) : numero(item?.caixas);
}

function formatarMetrica(valor, metrica) {
  return metrica === "peso" ? formatarPeso(valor) : formatarNumero(valor) + " caixas";
}

function percent(valor, total) {
  if (numero(total) <= 0) return 0;
  return Math.max(0, Math.min(100, (numero(valor) / numero(total)) * 100));
}

async function selectAll(table) {
  const { data, error } = await supabase.from(table).select("*");
  if (error) return { data: [], error: table + ": " + error.message };
  return { data: Array.isArray(data) ? data : [], error: null };
}

